# gemini = Gemma 4 via Gemini API, ollama = local open weights
PROVIDER=gemini
GEMINI_API_KEY=your-key-here
# exact Gemma 4 model id, see README "Find the model id"
GEMMA_MODEL=gemma-4-26b-a4b-it
# minimal = much faster on gemma-4-26b-a4b-it; leave empty for models that reject it (e.g. gemma-4-31b-it)
GEMMA_THINKING=minimal
OLLAMA_URL=http://localhost:11434
CORS_ORIGINS=http://localhost:5173
